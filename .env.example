APP_NAME=Lattely
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
TRUST_PROXY_HOPS=0
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lattely
DB_PASS=replace-me
DB_NAME=lattely
DB_SYNCHRONIZE=true
DB_RUN_MIGRATIONS=false

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=replace-me
MAIL_PASS=replace-me
MAIL_FROM=Lattely <no-reply@example.com>
MAIL_CONNECTION_TIMEOUT_MS=10000
MAIL_GREETING_TIMEOUT_MS=10000
MAIL_SOCKET_TIMEOUT_MS=20000

OTP_TTL_MIN=10
OTP_RESEND_COOLDOWN_SEC=60
OTP_MAX_ATTEMPTS=5
OTP_HASH_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
MAX_REEL_MB=100

GOOGLE_PLACES_API_KEY=replace-me
GOOGLE_PLACES_RADIUS_METERS=2000
GOOGLE_PLACES_MAX_RESULTS=10
GOOGLE_PLACES_TIMEOUT_MS=10000
COFFEE_REQUESTS_PER_HOUR=5
COFFEE_REQUESTS_PER_DAY=15

# Required to enable the 60-second pre-meet video call
AGORA_APP_ID=
AGORA_APP_CERT=
AGORA_TOKEN_TTL_SEC=65
